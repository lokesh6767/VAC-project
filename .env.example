# AI Insight — Environment Configuration
# Copy this file to .env.local for local development.
# Note: In Demo Mode, the platform functions 100% locally with zero external API dependencies.

# Optional: Supabase / PostgreSQL Credentials (if connecting to external database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Optional: AI Provider Direct Adapters (for optional live API evaluation)
# Note: Stored securely server-side; NEVER exposed to client browser bundles
OPENAI_API_KEY=sk-placeholder-openai-key
ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-key
GOOGLE_AI_API_KEY=AIzaSyPlaceholder-google-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-key-placeholder

# Application Environment
NODE_ENV=development
PORT=3000
